# Postgres (used by docker-compose db service and DATABASE_URL below)
POSTGRES_USER=cloudflax
POSTGRES_PASSWORD=cloudflax
POSTGRES_DB=cloudflax_ecommerce

# Prisma — inside docker-compose network use host "db" port 5432; from your host machine use "localhost" port 5433
DATABASE_URL="postgresql://cloudflax:cloudflax@db:5432/cloudflax_ecommerce?schema=public"

# Redis — inside docker-compose network use host "redis" port 6379; from your host machine use "localhost" port 6380
REDIS_URL="redis://redis:6379"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
