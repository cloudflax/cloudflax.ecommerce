# Postgres (used by docker-compose db service and DATABASE_URL below)
POSTGRES_USER=cloudflax
POSTGRES_PASSWORD=cloudflax
POSTGRES_DB=cloudflax_ecommerce

# Prisma — inside docker-compose network use host "db" port 5432; from your host machine use "localhost" port 5433
DATABASE_URL="postgresql://cloudflax:cloudflax@db:5432/cloudflax_ecommerce?schema=public"

# Redis — inside docker-compose network use host "redis" port 6379; from your host machine use "localhost" port 6380
REDIS_URL="redis://redis:6379"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Failed login attempts allowed per email before rate-limit kicks in (window: 60s)
LOGIN_RATE_LIMIT=3

# Login attempts allowed per client IP (window: 60s). Higher than LOGIN_RATE_LIMIT
# on purpose: this one stops password spraying across many accounts, and has to
# leave room for several people sharing an office or mobile-carrier NAT.
LOGIN_IP_RATE_LIMIT=20

# Sign-ups allowed per client IP (window: 1h)
REGISTER_RATE_LIMIT=5

# Verification emails allowed per address (window: 5min) — caps inbox flooding
# and protects the Resend daily quota
RESEND_RATE_LIMIT=1

# How often the session role is re-read from the database (seconds). Role
# changes take up to this long to propagate to existing sessions. Also the TTL
# of the role cache in Redis. The e2e suite overrides it to a small value.
ROLE_REVALIDATE_SECONDS=300

# How many reverse proxies sit in front of the app. Used to pick the trustworthy
# entry of "x-forwarded-for": the last N were appended by our own infrastructure,
# anything further left was sent by the client and can be forged. Set to 0 when
# the app is exposed directly (no proxy) — then no IP is trusted at all, and the
# per-IP rate limits collapse into a single shared counter.
TRUSTED_PROXY_HOPS=1

# Resend — used to send email-verification links
RESEND_API_KEY="re_xxx"
EMAIL_FROM="onboarding@resend.dev"

# Sentry — DSN from your project's Client Keys settings, safe to expose publicly
NEXT_PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.us.sentry.io/xxx"
